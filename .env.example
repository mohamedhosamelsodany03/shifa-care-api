# Copy to .env and fill in before launch. NEVER commit a real .env.
PORT=3000
NODE_ENV=development
# REQUIRED in production — long random strings:
JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_PIN=123456
# Mock OTP (dev convenience). Default ON in dev, OFF in production.
# Set MOCK_OTP=false in production. Demo phones 01000000001/01000000002 use 123456 in mock mode.
MOCK_OTP=true
# Payment number shown only after a booking is confirmed (never in bootstrap).
PAYMENT_NUMBER=01008629060
# CORS allowlist (comma-separated). Default is localhost only.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080
# Approximate FX for tourist EGP equivalents (override as needed).
USD_EGP=48
EUR_EGP=52
# OTP providers (TODO — see src/otp.js). WhatsApp first, SMS fallback.
# WHATSAPP_PROVIDER=
# WHATSAPP_API_KEY=
# WHATSAPP_SENDER=
# SMS_PROVIDER=
# SMS_API_KEY=
# SMS_SENDER=
# Where the JSON store lives (default: ./data.json next to server.js).
# DATA_FILE=
# Escrow sweep interval (ms). Default 5 minutes.
# SWEEP_INTERVAL_MS=300000
