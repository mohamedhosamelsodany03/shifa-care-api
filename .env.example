# Copy to .env and fill in before launch. NEVER commit a real .env.
PORT=3000
NODE_ENV=development
# REQUIRED in production — long random strings:
JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_PIN=123456
# Mock OTP (dev convenience). Default ON in dev, OFF in production.
# Set MOCK_OTP=false in production. Demo phones 01000000001/01000000002 use 123456 in mock mode.
MOCK_OTP=true
# Payment number shown only after a booking is confirmed (never in bootstrap).
PAYMENT_NUMBER=01008629060
# CORS allowlist (comma-separated). Default is localhost only.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080
# Approximate FX for tourist EGP equivalents (override as needed).
USD_EGP=48
EUR_EGP=52
# OTP providers — Meta WhatsApp Cloud API first, SMS fallback.
# WhatsApp sender number (Shifa Care WhatsApp Business): 01222771626.
# WHATSAPP_PROVIDER=meta enables the real provider; leave unset in dev
# to keep the mock provider. In production an unset/misconfigured
# provider fails closed (otp/request -> 502 otp_provider_error).
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=<permanent-system-user-token-from-meta>
WHATSAPP_PHONE_NUMBER_ID=<numeric-phone-number-id-from-whatsapp-manager>
WHATSAPP_SENDER=01222771626
WHATSAPP_TEMPLATE_NAME=otp_code
WHATSAPP_TEMPLATE_LANG=en_US
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_API_KEY=  (legacy alias for WHATSAPP_ACCESS_TOKEN — prefer the new name)
# SMS_PROVIDER=
# SMS_API_KEY=
# SMS_SENDER=
# Where the JSON store lives (default: ./data.json next to server.js).
# DATA_FILE=
# Escrow sweep interval (ms). Default 5 minutes.
# SWEEP_INTERVAL_MS=300000
