# Copy to .env and fill in before launch. NEVER commit a real .env.
PORT=3000
NODE_ENV=development
# REQUIRED in production — long random strings:
JWT_SECRET=change-me-to-a-long-random-secret
# No default PIN is seeded: without ADMIN_PIN, admin login is disabled.
ADMIN_PIN=<set-a-strong-6-digit-pin-in-the-host-dashboard>
# Mock OTP (dev convenience). Default ON in dev, OFF in production.
# Set MOCK_OTP=false in production. Demo phones 01000000001/01000000002 use 123456 in mock mode.
MOCK_OTP=true
# Payment number shown only after a booking is confirmed (never in bootstrap).
PAYMENT_NUMBER=01008629060
# CORS allowlist (comma-separated). Default is localhost only.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080
# Approximate FX for tourist EGP equivalents (override as needed).
USD_EGP=48
EUR_EGP=52
# OTP providers — Meta WhatsApp Cloud API first, SMS fallback.
# WhatsApp sender number (Shifa Care WhatsApp Business): 01222771626.
# WHATSAPP_PROVIDER=meta enables the real provider; leave unset in dev
# to keep the mock provider. In production an unset/misconfigured
# provider fails closed (otp/request -> 502 otp_provider_error).
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=<permanent-system-user-token-from-meta>
WHATSAPP_PHONE_NUMBER_ID=<numeric-phone-number-id-from-whatsapp-manager>
WHATSAPP_SENDER=01222771626
WHATSAPP_TEMPLATE_NAME=otp_code
WHATSAPP_TEMPLATE_LANG=en_US
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_API_KEY=  (legacy alias for WHATSAPP_ACCESS_TOKEN — prefer the new name)
# SMS OTP + SMS notification fallback — Together SMS (Egypt).
# Docs: https://sms.masrbokra.com/en/smspro-service-api.html
# STATUS (owner decision 26 Nov 2026): the owner will NOT pay the sender
# activation now (2,150 EGP + 14% VAT = 2,451 EGP one-time, then 0.27
# EGP/message, min balance 1,000 units, 1,000 free SMS after activation).
# The provider code is READY but DISABLED until these vars are set in
# Railway. Until then OTP login runs on the mock provider in dev and
# phone-only login stays the fallback in production. Activation needs a
# Commercial Register + Tax Card (7–10 business days). Endpoint default:
# https://togethersms.com/sendsms.php (legacy sms.masrbokra.com until
# 30 Jun 2027). NEVER log the password (it travels in the request URL).
# SMS_PROVIDER=together
# TOGETHER_SMS_USER=<api-account-username>
# TOGETHER_SMS_PASSWORD=<api-account-password>
# TOGETHER_SMS_SENDER=<approved-sender-id-up-to-11-chars>
# TOGETHER_SMS_ENDPOINT=https://togethersms.com/sendsms.php
# SMS_API_KEY=
# SMS_SENDER=
# Firebase Cloud Messaging (push notifications) — HTTP v1, no SDK.
# No Firebase project exists yet (parent agent creates it — it is free).
# Until these are set, push is disabled and notifications stay in-app
# only. NEVER commit the service-account JSON or the private key.
# FIREBASE_SERVICE_ACCOUNT_JSON=<service-account-json>
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=<service-account-private-key>
# Postgres persistence (v2.1.0) — DATABASE_URL is the toggle.
# Unset = local data.json file store (wiped on every Railway redeploy).
# Set = the whole app document lives in one Postgres row and survives
# redeploys (first boot imports data.json once). Create the Postgres
# service in Railway, then add DATABASE_URL to the API service (e.g.
# ${{Postgres.DATABASE_URL}}). Cost: ~$5–7/mo extra usage; app + small
# Postgres ≈ $8.65/mo total on Hobby (bill = max($5, usage)). Enabling
# it burns trial credit faster — do NOT set it until the owner agrees.
# DATABASE_URL=
# Where the JSON store lives (default: ./data.json next to server.js).
# DATA_FILE=
# Escrow sweep interval (ms). Default 5 minutes.
# SWEEP_INTERVAL_MS=300000
# Promo-month commission override (v2.0.9, owner decision 26 Nov 2026):
# when set (0–100), it OVERRIDES the tier rate for bookings accepted
# while it is active. Unset = tier rates (Starter 15% / Pro 12% / Elite 8%).
# The admin endpoint POST /api/admin/promo takes precedence over this var.
# Promo months are capped at 2 per calendar year; a 0% promo month PAUSES
# the cash volume bonus (titles still awarded).
# PROMO_COMMISSION_PCT=
